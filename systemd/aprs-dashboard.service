[Unit]
Description=Direwolf APRS Dashboard
After=network-online.target direwolf.service
Wants=network-online.target
RequiresMountsFor=/home/aprs

[Service]
Type=simple
User=aprs
Group=aprs
SupplementaryGroups=audio dialout systemd-journal
WorkingDirectory=/home/aprs/aprs-dashboard
EnvironmentFile=-/home/aprs/.config/aprs-dashboard.env
ExecStart=/home/aprs/aprs-dashboard/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
