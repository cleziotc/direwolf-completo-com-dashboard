# Identidade da estação
APRS_CALLSIGN=N0CALL-10
APRS_LOCATION_LABEL=Minha cidade
APRS_TIMEZONE=UTC

# Arquivo principal do Direwolf
DIREWOLF_CONFIG=/home/aprs/direwolf.conf
APRS_DASHBOARD_DIR=/home/aprs/aprs-dashboard

# Placa de áudio USB / ALSA
APRS_ALSA_CARD=0
APRS_ALSA_DEVICE_INDEX=0
APRS_AUDIO_DEVICE=plughw:0,0
APRS_AUDIO_CARD_NAME=USB
APRS_AUDIO_USB_VENDOR_ID=
APRS_AUDIO_USB_PRODUCT_ID=

# Método de PTT:
#   none   = RX-only / sem PTT
#   serial = DTR/RTS em porta serial (padrão do instalador Ubuntu)
#   gpiod  = GPIO nativo via libgpiod (padrão do instalador Raspberry)
APRS_PTT_MODE=none

# PTT serial
APRS_SERIAL_PORT=/dev/serial/by-id/SEU-DISPOSITIVO
APRS_SERIAL_USB_VENDOR_ID=
APRS_SERIAL_USB_PRODUCT_ID=

# PTT GPIO/GPIOD (Raspberry Pi)
APRS_GPIO_CHIP=/dev/gpiochip0
APRS_GPIO_LINE=25
APRS_GPIO_INVERT=0

# Diretórios de dados
APRS_CONFIG_BACKUP_DIR=/home/aprs/aprs-dashboard/data/config-backups
APRS_OFFLINE_MAP_DIR=/home/aprs/aprs-dashboard/data/offline-maps
